# Everything the app itself reads is in config.yaml (copy config.example.yaml).
# The values below are what config.yaml pulls in with `env:NAME`, plus the few
# things read straight from the environment (ORIGIN by adapter-node,
# DATABASE_URL by drizzle-kit, the rest by docker compose).

# === SITE SETTINGS
ORIGIN="http://localhost:5173"
DATABASE_URL="mysql://root:mysecretpassword@localhost:3306/servatrice"
#CONFIG_FILE="./config.yaml"
#MYSQL_ROOT_PASSWORD="mysecretpassword"

# === AUTHENTICATION
# Signs the sign-in cookie. At least 32 characters: openssl rand -hex 32
AUTH_SECRET="CHANGE-ME"
# Referenced by the providers in config.yaml; name them whatever you like.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
